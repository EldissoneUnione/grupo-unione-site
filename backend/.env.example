# API do backend (backend/src/config/env.js)
# Copiar para .env e preencher com os valores reais. Não versionar o .env.

# Porta da API.
PORT=3000

# Ligação PostgreSQL usada pelo Prisma.
DATABASE_URL="postgresql://utilizador:palavra-passe@localhost:5432/nome_da_base"

# Segredo de assinatura dos tokens JWT. Em produção usar um valor longo e
# aleatório: openssl rand -base64 48
JWT_SECRET=alterar-em-producao

# Validade dos tokens emitidos no login.
JWT_EXPIRES_IN=24h

NODE_ENV=development
